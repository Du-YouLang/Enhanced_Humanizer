# New project environments and all operational evidence stay in this workspace.
.local-workbench/
.venv/
.venv-*/
.conda/
node_modules/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/

