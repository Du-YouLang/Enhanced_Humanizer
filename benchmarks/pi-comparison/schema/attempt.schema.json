{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "run_id",
    "task_id",
    "flow_id",
    "provider",
    "model_id_requested",
    "model_id_observed",
    "task_contract_sha256",
    "env_hash",
    "base_sha",
    "result_sha",
    "evidence_kind",
    "hidden_grade",
    "usage",
    "missing_reason",
    "api_cost_usd_actual_or_reconciled",
    "total_elapsed_sec"
  ],
  "properties": {
    "flow_id": {
      "enum": [
        "P0",
        "P1",
        "P2",
        "P3",
        "H0",
        "A",
        "B",
        "C",
        "D",
        "E",
        "F"
      ]
    },
    "provider": {
      "enum": [
        "deepseek",
        "openai",
        "mixed"
      ]
    },
    "evidence_kind": {
      "enum": [
        "REAL_MODEL",
        "ZERO_MODEL_CONTROL"
      ]
    },
    "hidden_grade": {
      "enum": [
        "PASS",
        "FAIL",
        "TIMEOUT",
        "INFRA_FAIL",
        "INDETERMINATE",
        "NOT_RUN",
        "BLOCKED_INPUT",
        "BLOCKED_CREDENTIAL",
        "NOT_COMPARABLE"
      ]
    },
    "usage": {
      "type": "object",
      "required": [
        "input_tokens",
        "output_tokens",
        "cache_read_tokens",
        "cache_write_tokens",
        "reasoning_tokens"
      ],
      "properties": {
        "input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "output_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "cache_read_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "cache_write_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "reasoning_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "api_cost_usd_actual_or_reconciled": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "total_elapsed_sec": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "hidden_grade": {
            "const": "PASS"
          }
        }
      },
      "then": {
        "required": [
          "independent_acceptance_sha256"
        ],
        "properties": {
          "evidence_kind": {
            "const": "REAL_MODEL"
          },
          "independent_acceptance_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "result_sha": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "evidence_kind": {
            "const": "ZERO_MODEL_CONTROL"
          }
        }
      },
      "then": {
        "properties": {
          "hidden_grade": {
            "const": "NOT_RUN"
          }
        }
      }
    }
  ]
}
